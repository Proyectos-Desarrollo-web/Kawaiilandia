<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>

  <main id="contenido" class="page-main">
    <div class="container">
      <div class="auth">
        <aside class="auth__aside">
          <h2>Únete a Kawaiilandia 💜</h2>
          <p>Crea tu cuenta y disfruta de una compra más fácil.</p>
          <ul class="auth__benefits">
            <li><span aria-hidden="true">🧾</span> Consulta tu historial de compras</li>
            <li><span aria-hidden="true">⚡</span> Compra más rápido, sin repetir tus datos</li>
            <li><span aria-hidden="true">🌸</span> Entérate primero de las novedades</li>
          </ul>
          <img src="https://images.unsplash.com/photo-1631567210298-d385d8d9476c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=800" alt="" width="140" height="140">
        </aside>

        <div class="auth__form">
          <h1>Crear cuenta</h1>
          <p>Completa tus datos para registrarte.</p>

          <% const hasErrors = Object.keys(errors).length > 0; %>
          <% const invalid = (name) => (errors[name] ? ' field--error' : ''); %>
          <% const aria = (name) => (errors[name] ? ` aria-invalid="true" aria-describedby="${name}-error"` : ''); %>
          <% if (hasErrors) { %>
            <div class="alert alert--error" role="alert"><span aria-hidden="true">⚠</span> Revisa los campos marcados en rojo para continuar.</div>
          <% } %>

          <form action="/register" method="post" enctype="multipart/form-data" novalidate>
            <div class="field<%= invalid('firstName') %>">
              <label for="firstName">Nombre</label>
              <input id="firstName" name="firstName" type="text" autocomplete="given-name" value="<%= values.firstName || '' %>" required<%- aria('firstName') %>>
              <% if (errors.firstName) { %><p class="field__error" id="firstName-error"><%= errors.firstName %></p><% } %>
            </div>
            <div class="field<%= invalid('lastName') %>">
              <label for="lastName">Apellido</label>
              <input id="lastName" name="lastName" type="text" autocomplete="family-name" value="<%= values.lastName || '' %>" required<%- aria('lastName') %>>
              <% if (errors.lastName) { %><p class="field__error" id="lastName-error"><%= errors.lastName %></p><% } %>
            </div>
            <div class="field<%= invalid('email') %>">
              <label for="email">Correo electrónico</label>
              <input id="email" name="email" type="email" autocomplete="email" placeholder="nombre@correo.com" value="<%= values.email || '' %>" required<%- aria('email') %>>
              <% if (errors.email) { %><p class="field__error" id="email-error"><%= errors.email %></p><% } %>
            </div>
            <div class="field<%= invalid('password') %>">
              <label for="password">Contraseña</label>
              <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required<%- aria('password') %>>
              <% if (errors.password) { %><p class="field__error" id="password-error"><%= errors.password %></p><% } else { %><p class="field__hint">Mínimo 8 caracteres.</p><% } %>
            </div>
            <div class="field<%= invalid('password2') %>">
              <label for="password2">Confirmar contraseña</label>
              <input id="password2" name="password2" type="password" autocomplete="new-password" required<%- aria('password2') %>>
              <% if (errors.password2) { %><p class="field__error" id="password2-error"><%= errors.password2 %></p><% } %>
            </div>
            <div class="check-wrap<%= invalid('terms') %>">
              <label class="check">
                <input type="checkbox" name="terms" required<%- aria('terms') %>>
                <span>Acepto los términos y condiciones y la política de tratamiento de datos.</span>
              </label>
              <% if (errors.terms) { %><p class="field__error" id="terms-error"><%= errors.terms %></p><% } %>
            </div>
            <div class="field<%= invalid('avatar') %>">
              <label for="avatar">Foto de perfil <small>(opcional)</small></label>
              <input id="avatar" name="avatar" type="file" accept="image/jpeg,image/png,image/webp,image/gif"<%- aria('avatar') %>>
              <% if (errors.avatar) { %><p class="field__error" id="avatar-error"><%= errors.avatar %></p><% } else { %><p class="field__hint">JPG, PNG, WEBP o GIF de máximo 2 MB.</p><% } %>
            </div>
            <button class="btn btn--lg btn--block" type="submit">Crear cuenta ✨</button>
          </form>
          <p class="auth__switch">¿Ya tienes cuenta? <a href="/login">Ingresa aquí</a></p>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>

digraph DER {
  graph [rankdir=LR, nodesep=0.55, ranksep=1.25, fontname="DejaVu Sans", labelloc=t, fontsize=20, pad=0.4, label=<<B>Kawaiilandia - Diagrama entidad-relación (Sprint 6)</B><BR/><FONT POINT-SIZE="11" COLOR="#555555">MySQL / MariaDB · PK = clave primaria · FK = clave foránea · una barra = "uno", pata de gallo = "muchos"</FONT>>];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=9, color="#3b2a4d", dir=both, arrowtail=teetee, arrowhead=crow, penwidth=1.4];
  user_categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3b2a4d" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E6D9F5"><B>user_categories</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">TINYINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(20)  UNIQUE</FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3b2a4d" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E6D9F5"><B>users</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(100)  UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(255)  (hash)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>FK</B></FONT></TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">TINYINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="image"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">image</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">DATETIME</FONT></TD></TR></TABLE>>];
  categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3b2a4d" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFD6EC"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">TINYINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(40)  UNIQUE</FONT></TD></TR></TABLE>>];
  products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3b2a4d" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFD6EC"><B>products</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="slug"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(80)  UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(400)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tag"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">tag</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="material"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">material</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="image"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">image</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>FK</B></FONT></TD><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">TINYINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">DATETIME</FONT></TD></TR></TABLE>>];
  colors [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3b2a4d" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFD6EC"><B>colors</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(20)  UNIQUE</FONT></TD></TR></TABLE>>];
  sizes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3b2a4d" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFD6EC"><B>sizes</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(20)  UNIQUE</FONT></TD></TR></TABLE>>];
  product_colors [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3b2a4d" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF3C4"><B>product_colors</B></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="color_id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT">color_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="position"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">TINYINT UNSIGNED</FONT></TD></TR></TABLE>>];
  product_sizes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3b2a4d" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF3C4"><B>product_sizes</B></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="size_id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT">size_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">SMALLINT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="position"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">TINYINT UNSIGNED</FONT></TD></TR></TABLE>>];
  carts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3b2a4d" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#D4F1E4"><B>carts</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">ENUM('open','completed')</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">DATETIME</FONT></TD></TR></TABLE>>];
  cart_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3b2a4d" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#D4F1E4"><B>cart_items</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>PK</B></FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cart_id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>FK</B></FONT></TD><TD ALIGN="LEFT">cart_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>FK</B></FONT></TD><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">TINYINT UNSIGNED  (1 a 10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="color"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">color</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="size"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">size</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="9" COLOR="#7A2E5A"><B>&#160;&#160;&#160;</B></FONT></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555" POINT-SIZE="10">DATETIME</FONT></TD></TR></TABLE>>];
  user_categories -> users [headlabel="category_id", labeldistance=3.4, labelangle=0, labelfontcolor="#7A2E5A"];
  users -> carts [headlabel="user_id", labeldistance=3.4, labelangle=0, labelfontcolor="#7A2E5A"];
  carts -> cart_items [headlabel="cart_id", labeldistance=3.4, labelangle=0, labelfontcolor="#7A2E5A"];
  products -> cart_items [headlabel="product_id", labeldistance=3.4, labelangle=0, labelfontcolor="#7A2E5A"];
  categories -> products [headlabel="category_id", labeldistance=3.4, labelangle=0, labelfontcolor="#7A2E5A"];
  products -> product_colors [headlabel="product_id", labeldistance=3.4, labelangle=0, labelfontcolor="#7A2E5A"];
  colors -> product_colors [headlabel="color_id", labeldistance=3.4, labelangle=0, labelfontcolor="#7A2E5A"];
  products -> product_sizes [headlabel="product_id", labeldistance=3.4, labelangle=0, labelfontcolor="#7A2E5A"];
  sizes -> product_sizes [headlabel="size_id", labeldistance=3.4, labelangle=0, labelfontcolor="#7A2E5A"];
}

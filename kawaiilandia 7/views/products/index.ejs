<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>

  <main id="contenido" class="page-main">
    <div class="container">
      <% if (status === 'eliminado') { %>
        <div class="alert alert--ok" role="status"><span aria-hidden="true">✓</span> Producto eliminado correctamente.</div>
      <% } %>

      <div class="toolbar">
        <div>
          <h1 class="page-title">Productos</h1>
          <p>
            <% const noun = pagination.total === 1 ? 'producto' : 'productos'; %>
            <% if (q && selectedCategory) { %>
              <%= pagination.total %> <%= noun %> con “<strong><%= q %></strong>” en <strong><%= selectedCategory %></strong>.
            <% } else if (q) { %>
              <%= pagination.total %> <%= noun %> con “<strong><%= q %></strong>”.
            <% } else if (selectedCategory) { %>
              <%= pagination.total %> <%= noun %> en <strong><%= selectedCategory %></strong>.
            <% } else { %>
              Todo el catálogo de Kawaiilandia: <%= pagination.total %> <%= noun %>.
            <% } %>
          </p>
        </div>
        <% if (locals.isAdmin) { %><a class="btn btn--lg" href="/products/create">＋ Nuevo producto</a><% } %>
      </div>

      <form class="search" action="/products" method="get" role="search">
        <label class="sr-only" for="q">Buscar productos</label>
        <input id="q" name="q" type="search" value="<%= q %>" placeholder="Buscar peluches, mugs, termos..." maxlength="60">
        <% if (selectedCategory) { %><input type="hidden" name="categoria" value="<%= selectedCategory %>"><% } %>
        <button class="btn" type="submit">🔍 Buscar</button>
        <% if (q) { %><a class="btn btn--ghost" href="/products<%= selectedCategory ? '?categoria=' + encodeURIComponent(selectedCategory) : '' %>">Limpiar</a><% } %>
      </form>

      <nav class="chips" aria-label="Filtrar por categoría">
        <a class="chip<%= selectedCategory ? '' : ' chip--active' %>" href="/products<%= q ? '?q=' + encodeURIComponent(q) : '' %>"<%- selectedCategory ? '' : ' aria-current="true"' %>>Todos</a>
        <% categories.forEach((cat) => { %>
          <a class="chip<%= selectedCategory === cat ? ' chip--active' : '' %>" href="/products?categoria=<%= encodeURIComponent(cat) %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"<%- selectedCategory === cat ? ' aria-current="true"' : '' %>><%= cat %></a>
        <% }) %>
      </nav>

      <% if (products.length) { %>
        <div class="grid grid--cards">
          <% products.forEach((product) => { %>
            <%- include('../partials/product-card', { product }) %>
          <% }) %>
        </div>
        <%- include('../partials/pagination', {
          pagination,
          basePath: '/products',
          params: { categoria: selectedCategory || '', q: q || '' }
        }) %>
      <% } else if (q) { %>
        <p class="empty">No encontramos productos con “<%= q %>”. Prueba con otra palabra o <a class="link" href="/products">mira todo el catálogo</a>.</p>
      <% } else { %>
        <p class="empty">Aún no hay productos en esta categoría.<% if (locals.isAdmin) { %> <a class="link" href="/products/create">¡Agrega el primero!</a><% } %></p>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>

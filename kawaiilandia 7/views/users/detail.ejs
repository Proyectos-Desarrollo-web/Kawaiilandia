<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>

  <main id="contenido" class="page-main">
    <div class="container">
      <% if (locals.isAdmin && !isSelf) { %>
        <nav aria-label="Ruta de navegación">
          <ol class="breadcrumb">
            <li><a href="/">Inicio</a></li>
            <li><a href="/users">Usuarios</a></li>
            <li aria-current="page"><%= profile.firstName %> <%= profile.lastName %></li>
          </ol>
        </nav>
      <% } %>
      <h1 class="page-title"><%= isSelf ? 'Mi perfil 🌸' : 'Perfil de usuario' %></h1>

      <section class="profile" aria-labelledby="profile-name">
        <img class="profile__img" src="<%= profile.image %>" onerror="this.onerror=null;this.src='/img/logo.svg'" alt="Foto de perfil de <%= profile.firstName %>" width="140" height="140">
        <div class="profile__info">
          <h2 id="profile-name"><%= profile.firstName %> <%= profile.lastName %></h2>
          <span class="pill"><%= profile.category === 'admin' ? 'Administración' : 'Cliente' %></span>
          <dl class="profile__data">
            <div><dt>Nombre</dt><dd><%= profile.firstName %></dd></div>
            <div><dt>Apellido</dt><dd><%= profile.lastName %></dd></div>
            <div><dt>Correo electrónico</dt><dd><%= profile.email %></dd></div>
            <div><dt>Tipo de cuenta</dt><dd><%= profile.category === 'admin' ? 'Administrador' : 'Cliente' %></dd></div>
            <div><dt>Miembro desde</dt><dd><%= new Date(profile.createdAt).toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' }) %></dd></div>
          </dl>
          <div class="btn-group">
            <a class="btn" href="/users/<%= profile.id %>/edit">✏️ Editar <%= isSelf ? 'mi perfil' : 'usuario' %></a>
            <% if (isSelf) { %>
              <a class="btn btn--ghost" href="/carrito">🛒 Ver mi carrito</a>
              <% if (locals.isAdmin) { %><a class="btn btn--ghost" href="/users">👥 Ver usuarios</a><a class="btn btn--ghost" href="/products/create">＋ Nuevo producto</a><% } %>
              <form action="/logout" method="post">
                <button class="btn btn--ghost" type="submit">Cerrar sesión</button>
              </form>
            <% } else { %>
              <a class="btn btn--ghost" href="/users">← Volver al listado</a>
            <% } %>
          </div>
        </div>
      </section>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>

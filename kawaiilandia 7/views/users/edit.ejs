<%
  const invalid = (name) => (errors[name] ? ' field--error' : '');
  const aria = (name) => (errors[name] ? ` aria-invalid="true" aria-describedby="${name}-error"` : '');
  const hasErrors = Object.keys(errors).length > 0;
%>
<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body>
  <%- include('../partials/header') %>

  <main id="contenido" class="page-main">
    <div class="container">
      <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
          <li><a href="/">Inicio</a></li>
          <% if (isSelf) { %>
            <li><a href="/profile">Mi perfil</a></li>
          <% } else { %>
            <li><a href="/users">Usuarios</a></li>
            <li><a href="/users/<%= target.id %>"><%= target.firstName %> <%= target.lastName %></a></li>
          <% } %>
          <li aria-current="page">Editar</li>
        </ol>
      </nav>

      <h1 class="page-title"><%= isSelf ? 'Editar mi perfil' : 'Editar usuario' %></h1>

      <% if (hasErrors) { %>
        <div class="alert alert--error" role="alert"><span aria-hidden="true">⚠</span> Revisa los campos marcados en rojo para continuar.</div>
      <% } %>

      <form class="product-form" action="/users/<%= target.id %>?_method=PUT" method="post" enctype="multipart/form-data" data-validate="user-edit" novalidate>
        <div class="field<%= invalid('firstName') %>">
          <label for="firstName">Nombre</label>
          <input id="firstName" name="firstName" type="text" autocomplete="given-name" value="<%= values.firstName %>" required<%- aria('firstName') %>>
          <% if (errors.firstName) { %><p class="field__error" id="firstName-error"><%= errors.firstName %></p><% } %>
        </div>
        <div class="field<%= invalid('lastName') %>">
          <label for="lastName">Apellido</label>
          <input id="lastName" name="lastName" type="text" autocomplete="family-name" value="<%= values.lastName %>" required<%- aria('lastName') %>>
          <% if (errors.lastName) { %><p class="field__error" id="lastName-error"><%= errors.lastName %></p><% } %>
        </div>
        <div class="field<%= invalid('email') %>">
          <label for="email">Correo electrónico</label>
          <input id="email" name="email" type="email" autocomplete="email" value="<%= values.email %>" required<%- aria('email') %>>
          <% if (errors.email) { %><p class="field__error" id="email-error"><%= errors.email %></p><% } %>
        </div>

        <% if (canChangeCategory) { %>
          <div class="field<%= invalid('category') %>">
            <label for="category">Tipo de cuenta</label>
            <select id="category" name="category"<%- aria('category') %>>
              <% categories.forEach((cat) => { %>
                <option value="<%= cat %>"<%= values.category === cat ? ' selected' : '' %>><%= cat === 'admin' ? 'Administrador' : 'Cliente' %></option>
              <% }) %>
            </select>
            <% if (errors.category) { %><p class="field__error" id="category-error"><%= errors.category %></p><% } %>
          </div>
        <% } %>

        <fieldset class="form-section">
          <legend>Cambiar contraseña <small>(opcional)</small></legend>
          <p class="field__hint">Déjalo en blanco si no quieres cambiarla.</p>
          <% if (needsCurrentPassword) { %>
            <div class="field<%= invalid('currentPassword') %>">
              <label for="currentPassword">Contraseña actual</label>
              <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password"<%- aria('currentPassword') %>>
              <% if (errors.currentPassword) { %><p class="field__error" id="currentPassword-error"><%= errors.currentPassword %></p><% } %>
            </div>
          <% } %>
          <div class="field<%= invalid('password') %>">
            <label for="password">Contraseña nueva</label>
            <input id="password" name="password" type="password" autocomplete="new-password" maxlength="64"<%- aria('password') %>>
            <% if (errors.password) { %><p class="field__error" id="password-error"><%= errors.password %></p><% } %>
            <ul class="pw-rules" data-pw-rules-for="password" aria-label="Requisitos de la contraseña">
              <li data-rule="length">Al menos 8 caracteres</li>
              <li data-rule="lower">Una letra minúscula</li>
              <li data-rule="upper">Una letra mayúscula</li>
              <li data-rule="number">Un número</li>
              <li data-rule="special">Un carácter especial (por ejemplo ! ? # $ %)</li>
            </ul>
          </div>
          <div class="field<%= invalid('repassword') %>">
            <label for="repassword">Confirmar contraseña nueva</label>
            <input id="repassword" name="repassword" type="password" autocomplete="new-password"<%- aria('repassword') %>>
            <% if (errors.repassword) { %><p class="field__error" id="repassword-error"><%= errors.repassword %></p><% } %>
          </div>
        </fieldset>

        <div class="field<%= invalid('avatar') %>">
          <label for="avatar">Foto de perfil <small>(opcional)</small></label>
          <div class="avatar-edit">
            <img id="avatar-preview" class="img-preview" src="<%= target.image %>" onerror="this.onerror=null;this.src='/img/logo.svg'" alt="Foto de perfil" width="64" height="64">
            <input id="avatar" name="avatar" type="file" accept="image/jpeg,image/png,image/gif" data-max-mb="2" data-preview="avatar-preview"<%- aria('avatar') %>>
          </div>
          <% if (errors.avatar) { %><p class="field__error" id="avatar-error"><%= errors.avatar %></p><% } else { %><p class="field__hint">Si no eliges una foto se conserva la actual. JPG, JPEG, PNG o GIF de máximo 2 MB.</p><% } %>
        </div>

        <div class="form-actions">
          <button class="btn btn--lg" type="submit">Guardar cambios 💜</button>
          <a class="btn btn--ghost btn--lg" href="<%= isSelf ? '/profile' : '/users/' + target.id %>">Cancelar</a>
        </div>
      </form>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
